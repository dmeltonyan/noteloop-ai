import { useState } from 'react'
import HomePage from './pages/HomePage'
import FlashcardTestPage from './pages/FlashcardTestPage'
import FeedPage from './pages/FeedPage'

function App() {
  const [currentPage, setCurrentPage] = useState('home')

  if (currentPage === 'flashcards') {
    return <FlashcardTestPage />
  }

  if (currentPage === 'feed') {
    return <FeedPage />
  }

  return (
    <div>
      <HomePage />
      
      <div style={{
        position: 'fixed',
        bottom: '2rem',
        right: '2rem',
        display: 'flex',
        flexDirection: 'column',
        gap: '1rem',
        zIndex: 1000
      }}>
        <button
          onClick={() => setCurrentPage('feed')}
          style={{
            padding: '1rem 2rem',
            background: 'linear-gradient(to right, #ec4899, #8b5cf6)',
            color: 'white',
            border: 'none',
            borderRadius: '9999px',
            cursor: 'pointer',
            fontSize: '1.25rem',
            fontWeight: 'bold',
            boxShadow: '0 10px 25px rgba(0, 0, 0, 0.5)'
          }}
        >
          📱 Study Feed
        </button>
        
        <button
          onClick={() => setCurrentPage('flashcards')}
          style={{
            padding: '1rem 2rem',
            background: 'linear-gradient(to right, #9333ea, #2563eb)',
            color: 'white',
            border: 'none',
            borderRadius: '9999px',
            cursor: 'pointer',
            fontSize: '1.25rem',
            fontWeight: 'bold',
            boxShadow: '0 10px 25px rgba(0, 0, 0, 0.5)'
          }}
        >
          🤖 AI Flashcards
        </button>
      </div>
    </div>
  )
}

export default App
